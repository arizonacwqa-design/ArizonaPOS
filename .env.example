# Copy this file to .env and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
#
# Login setup: see SUPABASE_SETUP.md
# 1. Run supabase/migrations/001_profiles.sql in Supabase SQL Editor
# 2. Create users in Authentication → Users
# 3. Run supabase/migrations/002_backfill_profiles.sql

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Company info (shown on invoices)
VITE_COMPANY_NAME=Your Shop Name
VITE_COMPANY_ADDRESS=123 Main St, City, Country
VITE_COMPANY_PHONE=+1 (555) 000-0000
VITE_COMPANY_WHATSAPP=+1 (555) 000-0000
VITE_COMPANY_INSTAGRAM=@your_shop

# Optional default tax % on POS (0 = no tax)
VITE_DEFAULT_TAX_RATE=0

# License verification (Edge Function)
VITE_LICENSE_VERIFY_URL=https://vdjhwmdzbjztiqhyrmai.supabase.co/functions/v1/verify-license
